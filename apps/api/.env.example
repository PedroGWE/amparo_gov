NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://semevo:troque-esta-senha@localhost:5432/semevo?schema=public"

# JWT — mínimo 32 chars
JWT_SECRET="change-me-in-production-min-32-chars!!"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-refresh-secret-min-32-chars!!"
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL="redis://localhost:6379"

# Arquivos persistentes (monte este diretório como volume em produção)
STORAGE_DIR="./uploads"

# NFS-e Nacional via Focus NFe: credenciais por tenant, somente no backend.
# Configure primeiro em homologação; CNPJ deve coincidir com o cadastrado no instituto.
NFSE_FOCUS_TENANTS_JSON='{}'
NFSE_PRODUCTION_ENABLED=false
# Chave-mestra opcional e recomendada para tokens da tela Integrações (mínimo 32 caracteres).
# Sem ela, a API deriva uma chave isolada do JWT_SECRET.
NFSE_CREDENTIALS_KEY="troque-por-uma-chave-aleatoria-de-64-caracteres"

# CORS
CORS_ORIGINS="http://localhost:3000"
# API pública oficial de Gestão de Parcerias (sem autenticação)
TRANSFEREGOV_API_URL=https://api-publica.transferegov.gestao.gov.br/parcerias
TRANSFEREGOV_TIMEOUT_MS=15000
PORTAL_TRANSPARENCIA_TOKEN=
PORTAL_TRANSPARENCIA_TIMEOUT_MS=15000

# Catálogo de oportunidades e recursos (coletas exclusivamente no backend).
RESOURCES_SCHEDULER_ENABLED=true
# IDs de usuários operadores (separados por vírgula), além da permissão '*'.
# Administradores comuns de tenant não podem alterar conectores compartilhados.
RESOURCES_ADMIN_USER_IDS=
# Opcional: ano consultado nos programas Transferegov. Padrão: ano corrente.
# RESOURCES_PROGRAM_YEAR=2026
# Prosas: somente credenciais de administrador autorizadas, nunca NEXT_PUBLIC_*.
PROSAS_CLIENT_ID=
PROSAS_CLIENT_SECRET=
PROSAS_SCOPES=confidential:processos.read
PROSAS_ACCESS_CONFIRMED=false
# Testes opcionais: banco isolado com "test" no nome. Nunca usar produção.
# RESOURCE_TEST_DATABASE_URL=postgresql://postgres:password@localhost:55434/gtm_resources_test
# RESOURCE_LIVE_TEST=false
