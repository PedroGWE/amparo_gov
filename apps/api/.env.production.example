NODE_ENV=production
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/cidadao_futuro?schema=public"

# JWT — use strings longas e aleatórias (ex: openssl rand -base64 48)
JWT_SECRET="GERE_UM_SECRET_FORTE_AQUI"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="GERE_OUTRO_SECRET_FORTE_AQUI"
JWT_REFRESH_EXPIRES_IN=7d

# Redis (se com senha: redis://:SENHA@localhost:6379)
REDIS_URL="redis://localhost:6379"

# CORS — domínio público do frontend
CORS_ORIGINS="https://projeto.gtmcorepro.com,https://app.amparogov.org"

# NFS-e: credenciais por tenant no backend; inicie em HOMOLOGACAO.
NFSE_FOCUS_TENANTS_JSON='{}'
NFSE_PRODUCTION_ENABLED=false
NFSE_CREDENTIALS_KEY="gere-um-segredo-forte-e-mantenha-o-estavel"
