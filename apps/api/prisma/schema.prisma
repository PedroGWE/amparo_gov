  quantity      Decimal               @db.Decimal(18, 3)
  balance_after Decimal               @db.Decimal(18, 3)
  note          String?
  created_by    String
  created_at    DateTime              @default(now())

  tenant Tenant        @relation(fields: [tenant_id], references: [id])
  item   InventoryItem @relation(fields: [item_id], references: [id])
  actor  User          @relation(fields: [created_by], references: [id])

  @@index([tenant_id, created_at])
  @@index([item_id, created_at])
  @@map("inventory_movements")
}

model UserInvite {
  id          String       @id @default(cuid())
  tenant_id   String
  email       String
  role_id     String?
  status      InviteStatus @default(PENDING)
  token_hash  String       @unique
  invited_by  String?
  expires_at  DateTime
  accepted_at DateTime?
  created_at  DateTime     @default(now())

  // Relations
  tenant  Tenant @relation(fields: [tenant_id], references: [id])
  role    Role?  @relation(fields: [role_id], references: [id])
  inviter User?  @relation("InviteSender", fields: [invited_by], references: [id])

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([token_hash])
  @@index([status])
  @@index([expires_at])
  @@map("user_invites")
}

// ============================================================
// EDITAIS, BENEFICIÁRIOS E EQUIPE EDUCACIONAL
// ============================================================

model Edital {
  id                     String          @id @default(cuid())
  tenant_id              String?
  project_id             String?
  fonte                  EditalFonte
  external_id            String?
  titulo                 String
  orgao                  String?
  descricao              String?
  valor_total            Decimal?        @db.Decimal(18, 2)
  data_abertura          DateTime?
  data_encerramento      DateTime?
  abrangencia            OrgAbrangencia?
  uf                     String?
  area_tematica          String?
  link_oficial           String?
  requisitos_documentais String[]        @default([])
  created_by             String?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  tenant                 Tenant?         @relation(fields: [tenant_id], references: [id])
  salvos                 SavedEdital[]
  project                Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  cursos                 Curso[] @relation("CursoEditais")

  @@index([tenant_id])
  @@index([project_id])
  @@index([fonte, external_id])
  @@map("editais")
}

model SavedEdital {
  id                String            @id @default(cuid())
  tenant_id         String
  edital_ref        String
  fonte             EditalFonte
  external_id       String?
  edital_id         String?
  titulo            String
  orgao             String?
  data_encerramento DateTime?
  status            SavedEditalStatus @default(SALVO)
  notas             String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenant_id], references: [id])
  edital            Edital?           @relation(fields: [edital_id], references: [id])

  @@unique([tenant_id, edital_ref])
  @@index([tenant_id])
  @@index([status])
  @@map("saved_editais")
}

model Responsavel {
  id             String         @id @default(cuid())
  beneficiary_id String
  nome_completo  String
  parentesco     ParentescoType
  cpf            String?
  telefone       String?
  email          String?
  endereco       Json?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  beneficiary    Beneficiary    @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)

  @@index([beneficiary_id])
  @@map("responsaveis")
}

model BeneficiarioProjeto {
  id                String        @id @default(cuid())
  beneficiary_id    String
  project_id        String
  data_ingresso     DateTime
  data_desligamento DateTime?
  status            VinculoStatus @default(ATIVO)
  turma             String?
  turno             String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  beneficiary       Beneficiary   @relation(fields: [beneficiary_id], references: [id], onDelete: Cascade)
  project           Project       @relation(fields: [project_id], references: [id])

  @@unique([beneficiary_id, project_id])
  @@index([project_id])
  @@map("beneficiarios_projetos")
}

model Professor {
  user_id String? @unique
  user User? @relation("TeacherAccount", fields: [user_id], references: [id])
  id                       String               @id @default(cuid())
  tenant_id                String
  nome_completo            String
  cpf                      String
  rg                       String?
  data_nascimento          DateTime?
  telefone                 String?
  email                    String?
  foto_url                 String?
  cep                      String?
  logradouro               String?
  numero                   String?
  complemento              String?
  bairro                   String?
  cidade                   String?
  uf                       String?
  formacao_academica       String?
  especializacao           String?
  disciplinas              String[]             @default([])
  tipo_vinculo             TipoVinculo
  forma_pagamento          FormaPagamento?
  dados_bancarios          Json?
  dia_pagamento            Int?
  comprovante_formacao_url String?
  certificados_urls        String[]             @default([])
  contrato_url             String?
  status                   ProfessorStatus      @default(ATIVO)
  data_admissao            DateTime?
  data_desligamento        DateTime?
  observacoes              String?
  created_by               String?
  created_at               DateTime             @default(now())
  updated_at               DateTime             @updatedAt
  tenant                   Tenant               @relation(fields: [tenant_id], references: [id])
  projetos                 ProfessorProjeto[]
  historico                HistoricoProfessor[]

  @@unique([tenant_id, cpf])
  @@index([tenant_id])
  @@index([status])
  @@map("professores")
}

model ProfessorProjeto {
  id                    String          @id @default(cuid())
  professor_id          String
  project_id            String
  data_inicio           DateTime
  data_fim              DateTime?
  status                ProfessorStatus @default(ATIVO)
  carga_horaria_semanal Int?
  dias_horarios         Json?
  created_at            DateTime        @default(now())
  professor             Professor       @relation(fields: [professor_id], references: [id], onDelete: Cascade)
  project               Project         @relation(fields: [project_id], references: [id])

  @@unique([professor_id, project_id])
  @@index([project_id])
  @@map("professores_projetos")
}

model HistoricoProfessor {
  id              String    @id @default(cuid())
  professor_id    String
  valor_hora_aula Decimal?  @db.Decimal(18, 2)
  valor_mensal    Decimal?  @db.Decimal(18, 2)
  data_vigencia   DateTime
  motivo          String?
  created_by      String?
  created_at      DateTime  @default(now())
  professor       Professor @relation(fields: [professor_id], references: [id], onDelete: Cascade)

  @@index([professor_id, data_vigencia])
  @@map("historico_professores")
}

model Curso {
  id                String @id @default(cuid())
  tenant_id         String
  nome              String
  tipo              String @default("MODALIDADE")
  descricao         String?
  ativo             Boolean @default(true)
  inscricoes_abertas Boolean @default(true)
  tema_visual       String?
  legacy_project_id String? @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  tenant            Tenant @relation(fields: [tenant_id], references: [id])
  legacy_project    Project? @relation("CursoLegacyProject", fields: [legacy_project_id], references: [id], onDelete: SetNull)
  projetos          Project[] @relation("CursoProjects")
  emendas           EmendaParlamentar[] @relation("CursoEmendas")
  editais           Edital[] @relation("CursoEditais")
  turmas            Turma[]
  alunos            Beneficiary[] @relation("CursoBeneficiarios")

  @@unique([tenant_id, nome])
  @@index([tenant_id, ativo])
  @@map("cursos")
}

model Turma {
  id           String      @id @default(cuid())
  tenant_id    String
  project_id   String?
  curso_id     String?
  professor_id String?
  nome         String
  capacidade   Int?
  horario      Json?
  deleted_at   DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenant_id], references: [id])
  project      Project?    @relation(fields: [project_id], references: [id])
  curso        Curso?      @relation(fields: [curso_id], references: [id], onDelete: SetNull)
  matriculas   Matricula[]
  atividades   Atividade[]
  presencas    Presenca[]
  aulas EducaAula[]
  materiais EducaMaterial[]

  @@index([tenant_id])
  @@index([professor_id])
  @@index([curso_id])
  @@map("turmas")
}

model Matricula {
  id         String                 @id @default(cuid())
  tenant_id  String
  turma_id   String
  aluno_id   String
  status     ConectaMatriculaStatus @default(ATIVA)
  solicitante_tipo String?
  solicitante_nome String?
  solicitante_contato String?
  created_at DateTime               @default(now())
  tenant     Tenant                 @relation(fields: [tenant_id], references: [id])
  turma      Turma                  @relation(fields: [turma_id], references: [id])
  aluno      Beneficiary            @relation(fields: [aluno_id], references: [id])
  entregas   EntregaAtividade[]
  presencas  Presenca[]
  notas      NotaDesenvolvimento[]
  educa_presencas EducaPresenca[]

  @@unique([turma_id, aluno_id])
  @@index([tenant_id])
  @@index([turma_id, status, created_at])
  @@map("matriculas")
}

model Atividade {
  id         String                 @id @default(cuid())
  tenant_id  String
  turma_id   String
  titulo     String
  descricao  String?
  prazo      DateTime?
  status     ConectaAtividadeStatus @default(RASCUNHO)
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt
  tenant     Tenant                 @relation(fields: [tenant_id], references: [id])
  turma      Turma                  @relation(fields: [turma_id], references: [id])
  entregas   EntregaAtividade[]

  @@index([tenant_id, turma_id])
  @@map("conecta_atividades")
}

model EntregaAtividade {
  feedback String?
  anexos String[] @default([])
  id           String               @id @default(cuid())
  tenant_id    String
  atividade_id String
  matricula_id String
  status       ConectaEntregaStatus @default(PENDENTE)
  conteudo     String?
  nota         Decimal?             @db.Decimal(5, 2)
  entregue_at  DateTime?
  created_at   DateTime             @default(now())
  tenant       Tenant               @relation(fields: [tenant_id], references: [id])
  atividade    Atividade            @relation(fields: [atividade_id], references: [id])
  matricula    Matricula            @relation(fields: [matricula_id], references: [id])

  @@unique([atividade_id, matricula_id])
  @@index([tenant_id])
  @@map("entregas_atividades")
}

model Presenca {
  id           String    @id @default(cuid())
  tenant_id    String
  turma_id     String
  matricula_id String
  data         DateTime
  presente     Boolean   @default(false)
  created_at   DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenant_id], references: [id])
  turma        Turma     @relation(fields: [turma_id], references: [id])
  matricula    Matricula @relation(fields: [matricula_id], references: [id])

  @@unique([matricula_id, data])
  @@index([tenant_id, turma_id])
  @@map("presencas")
}

model NotaDesenvolvimento {
  id           String    @id @default(cuid())
  tenant_id    String
  matricula_id String
  periodo      String
  nota         Decimal?  @db.Decimal(5, 2)
  observacao   String?
  created_at   DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenant_id], references: [id])
  matricula    Matricula @relation(fields: [matricula_id], references: [id])

  @@index([tenant_id, matricula_id])
  @@map("notas_desenvolvimento")
}

model EducaAula {
  id String @id @default(cuid())
  tenant_id String
  turma_id String
  titulo String
  inicio DateTime
  fim DateTime
  meet_url String
  chamada_enviada_at DateTime?
  enviada_por String?
  versao Int @default(0)
  turma Turma @relation(fields: [turma_id], references: [id])
  presencas EducaPresenca[]
  @@index([tenant_id, turma_id, inicio])
  @@map("educa_aulas")
}
model EducaPresenca {
  id String @id @default(cuid())
  aula_id String
  matricula_id String
  status String
  aula EducaAula @relation(fields: [aula_id], references: [id], onDelete: Cascade)
  matricula Matricula @relation(fields: [matricula_id], references: [id])
  @@unique([aula_id, matricula_id])
  @@map("educa_presencas")
}
model EducaMaterial {
  id String @id @default(cuid())
  tenant_id String
  turma_id String
  titulo String
  texto String?
  anexo_id String?
  created_at DateTime @default(now())
  turma Turma @relation(fields: [turma_id], references: [id])
  @@index([tenant_id, turma_id])
  @@map("educa_materiais")
}
model EducaArquivo {
  id String @id @default(cuid())
  tenant_id String
  turma_id String
  user_id String
  nome String
  mime String
  caminho String
  created_at DateTime @default(now())
  @@index([tenant_id, turma_id])
  @@map("educa_arquivos")
}
