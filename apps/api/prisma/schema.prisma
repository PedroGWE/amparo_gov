// ============================================================
// TENANT & IDENTITY
// ============================================================

model Tenant {
  id         String       @id @default(cuid())
  slug       String       @unique
  name       String
  type       TenantType
  plan       TenantPlan   @default(FREE)
  status     TenantStatus @default(TRIAL)
  settings   Json         @default("{}")
  logo_url   String?
  cnpj       String?      @unique
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  deleted_at DateTime?

  // Relations
  users                        User[]
  roles                        Role[]
  organizations                Organization[]
  projects                     Project[]
  funding_opportunities        FundingOpportunity[]
  funding_applications         FundingApplication[]
  incentive_laws               IncentiveLaw[]
  convenios                    Convenio[]
  emendas                      EmendaParlamentar[]
  budgets                      Budget[]
  cost_centers                 CostCenter[]
  transactions                 Transaction[]
  payment_orders               PaymentOrder[]
  invoices                     Invoice[]
  fiscal_notes                 FiscalNote[]
  nfse_integration             NfseIntegration?
  bank_reconciliations         BankReconciliation[]
  documents                    Document[]
  accountability_reports       AccountabilityReport[]
  indicators                   Indicator[]
  beneficiaries                Beneficiary[]
  activities                   Activity[]
  partners                     Partner[]
  partnerships                 Partnership[]
  sponsors                     Sponsor[]
  workflow_templates           WorkflowTemplate[]
  workflow_instances           WorkflowInstance[]
  legal_requirements           LegalRequirement[]
  compliance_checks            ComplianceCheck[]
  lgpd_consents                LGPDConsent[]
  ai_agents                    AIAgent[]
  ai_conversations             AIConversation[]
  ai_tasks                     AITask[]
  document_embeddings          DocumentEmbedding[]
  notifications                Notification[]
  notification_templates       NotificationTemplate[]
  system_settings              SystemSetting[]
  audit_logs                   AuditLog[]
  document_folders             DocumentFolder[]
  user_invites                 UserInvite[]
  inventory_items              InventoryItem[]
  inventory_movements          InventoryMovement[]
  institutional_doc_categories InstitutionalDocCategory[]
  institutional_documents      InstitutionalDocument[]
  organization_profile         OrganizationProfile?
  editais                      Edital[]
  saved_editais                SavedEdital[]
  professores                  Professor[]
  turmas                       Turma[]
  cursos                       Curso[]
  matriculas                   Matricula[]
  conecta_atividades           Atividade[]
  entregas_atividades          EntregaAtividade[]
  presencas                    Presenca[]
  notas_desenvolvimento        NotaDesenvolvimento[]
  transferegov_integration     TransferegovIntegration?
  transferegov_records         TransferegovRecord[]
  transferegov_sync_runs       TransferegovSyncRun[]
  transferegov_changes         TransferegovChange[]
  resource_profile            ResourceOrganization?
  resource_records            ResourceRecord[]
  resource_favorites          ResourceFavorite[]

  @@index([slug])
  @@index([cnpj])
  @@index([status])
  @@index([deleted_at])
  @@map("tenants")
}

model User {
  resource_favorites ResourceFavorite[]
  student_code String?
  beneficiary Beneficiary? @relation("StudentAccount")
  professor_profile Professor? @relation("TeacherAccount")
  id                String     @id @default(cuid())
  tenant_id         String
  email             String
  password_hash     String
  name              String
  phone             String?
  avatar_url        String?
  status            UserStatus @default(ACTIVE)
  email_verified_at DateTime?
  last_login_at     DateTime?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  deleted_at        DateTime?

  // Relations
  tenant                  Tenant                  @relation(fields: [tenant_id], references: [id])
  user_roles              UserRole[]              @relation("UserToUserRole")
  granted_roles           UserRole[]              @relation("GrantedByUser")
  refresh_tokens          RefreshToken[]
  managed_projects        Project[]               @relation("ProjectManager")
  created_projects        Project[]               @relation("ProjectCreator")
  project_members         ProjectMember[]
  assigned_tasks          ProjectTask[]
  risk_owners             ProjectRisk[]
  ai_conversations        AIConversation[]
  notifications           Notification[]
  created_documents       Document[]              @relation("DocumentCreator")
  document_versions       DocumentVersion[]
  accountability_reports  AccountabilityReport[]  @relation("AccountabilityReportCreator")
  workflow_instances      WorkflowInstance[]      @relation("WorkflowStarter")
  workflow_approvals      WorkflowApproval[]
  compliance_checks       ComplianceCheck[]       @relation("ComplianceChecker")
  system_settings         SystemSetting[]
  audit_logs              AuditLog[]
  activity_responsible    Activity[]
  sent_invites            UserInvite[]            @relation("InviteSender")
  inventory_movements     InventoryMovement[]
  indicator_measurements  IndicatorMeasurement[]  @relation("MeasurementVerifier")
  created_indicators      Indicator[]
  created_transactions    Transaction[]           @relation("TransactionCreator")
  approved_transactions   Transaction[]           @relation("TransactionApprover")
  approved_payment_orders PaymentOrder[]
  validated_invoices      Invoice[]
  institutional_documents InstitutionalDocument[] @relation("InstitutionalDocUploader")

  @@unique([tenant_id, student_code])
  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([email])
  @@index([status])
  @@index([deleted_at])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenant_id   String
  name        String
  description String?
  is_system   Boolean  @default(false)
  permissions Json     @default("[]")
  created_at  DateTime @default(now())

  // Relations
  tenant       Tenant       @relation(fields: [tenant_id], references: [id])
  user_roles   UserRole[]
  user_invites UserInvite[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("roles")
}

model UserRole {
  user_id    String
  role_id    String
  granted_by String?
  granted_at DateTime  @default(now())
  expires_at DateTime?

  // Relations
  user            User  @relation("UserToUserRole", fields: [user_id], references: [id])
  role            Role  @relation(fields: [role_id], references: [id])
  granted_by_user User? @relation("GrantedByUser", fields: [granted_by], references: [id])

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@index([granted_by])
  @@index([expires_at])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RefreshToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  user_agent String?
  ip_address String?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenant_id   String
  user_id     String?
  action      String
  resource    String
  resource_id String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User?  @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([resource, resource_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// ============================================================
// ORGANIZATIONS
// ============================================================

model Organization {
  id            String     @id @default(cuid())
  tenant_id     String     @unique
  legal_name    String
  trade_name    String?
  cnpj          String?    @unique
  type          TenantType
  founded_at    DateTime?
  mission       String?
  vision        String?
  values        String?
  address       Json?
  social_links  Json?      @default("{}")
  bank_accounts Json?      @default("[]")
  certificates  Json?      @default("[]")
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  tenant    Tenant                 @relation(fields: [tenant_id], references: [id])
  documents OrganizationDocument[]

  @@index([tenant_id])
  @@index([cnpj])
  @@map("organizations")
}

model OrganizationDocument {
  id         String                     @id @default(cuid())
  org_id     String
  type       String
  name       String
  file_url   String
  issued_at  DateTime?
  expires_at DateTime?
  status     OrganizationDocumentStatus @default(VALIDO)
  created_at DateTime                   @default(now())

  // Relations
  organization Organization @relation(fields: [org_id], references: [id])

  @@index([org_id])
  @@index([status])
  @@index([expires_at])
  @@map("organization_documents")
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id              String        @id @default(cuid())
  tenant_id       String
  code            String?
  name            String
  description     String?
  type            ProjectType
  status          ProjectStatus @default(RASCUNHO)
  start_date      DateTime?
  end_date        DateTime?
  total_budget    Decimal?      @db.Decimal(18, 2)
  approved_budget Decimal?      @db.Decimal(18, 2)
  funding_sources Json?         @default("[]")
  tags            String[]      @default([])
  manager_id      String?
  created_by      String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  deleted_at      DateTime?

  // Relations
  tenant                 Tenant                 @relation(fields: [tenant_id], references: [id])
  manager                User?                  @relation("ProjectManager", fields: [manager_id], references: [id])
  creator                User?                  @relation("ProjectCreator", fields: [created_by], references: [id])
  members                ProjectMember[]
  phases                 ProjectPhase[]
  tasks                  ProjectTask[]
  risks                  ProjectRisk[]
  indicators             ProjectIndicator[]
  funding_applications   FundingApplication[]
  convenios              Convenio[]
  emendas                EmendaParlamentar[]
  budgets                Budget[]
  cost_centers           CostCenter[]
  transactions           Transaction[]
  documents              Document[]
  accountability_reports AccountabilityReport[]
  social_indicators      Indicator[]
  beneficiaries          Beneficiary[]
  activities             Activity[]
  partnerships           Partnership[]
  document_folders       DocumentFolder[]
