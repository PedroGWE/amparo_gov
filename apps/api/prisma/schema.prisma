  // Relations
  report AccountabilityReport @relation(fields: [report_id], references: [id])
  item   AccountabilityItem?  @relation(fields: [item_id], references: [id])

  @@index([report_id])
  @@index([item_id])
  @@index([status])
  @@map("accountability_glosses")
}

// ============================================================
