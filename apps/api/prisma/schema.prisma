  created_at  DateTime       @default(now())

  // Relations
  instance WorkflowInstance @relation(fields: [instance_id], references: [id])
  approver User?            @relation(fields: [approver_id], references: [id])

  @@index([instance_id])
  @@index([approver_id])
  @@index([status])
  @@map("workflow_approvals")
}

